# ---------------------------------------------------------------------------
# Avalanche C-Chain MAINNET (43114) deployment environment.
#
# Copy to .env.mainnet and fill in. NEVER commit the filled copy — .gitignore
# already covers .env*, but check before you stage.
#
#   set -a; source .env.mainnet; set +a
#   pnpm preflight:mainnet     # read-only, must print READY
#   CONFIRM_MAINNET=DEPLOY pnpm deploy:mainnet
#
# Rule of thumb: the mainnet deploy key is NOT the Fuji deploy key, the backend
# operator is NOT the deploy key, and the treasury is NOT either of them.
# ---------------------------------------------------------------------------

# --- chain access ----------------------------------------------------------
# A dedicated RPC endpoint. The public api.avax.network node is rate-limited and a
# throttled request mid-deploy leaves the suite half-wired.
AVALANCHE_RPC_URL=https://avalanche-mainnet.infura.io/v3/REPLACE_ME

# Separate variable from DEPLOYER_PRIVATE_KEY on purpose: a testnet key sitting in
# .env can then never sign a 43114 transaction.
MAINNET_DEPLOYER_PRIVATE_KEY=0xREPLACE_ME
# Floor for the deploy key's AVAX. The real requirement is max(this, 100x the
# full-suite gas cost at the live gas price) — scripts/lib/gas-budget.js.
MIN_DEPLOYER_AVAX=0.2
# Preflight fails if the backend operator holds less than this much AVAX.
MIN_OPERATOR_AVAX=0.2

# --- principals ------------------------------------------------------------
# ADMIN_ADDRESS is intentionally NOT set: on mainnet the deploy key must hold
# DEFAULT_ADMIN_ROLE to wire the suite, and governance then moves to the Safe via
# scripts/safe-transfer-admin.js. Setting it here is rejected by deploy.js.

# Receives the USDR initial supply. Use the Gnosis Safe if it already exists.
FOUNDATION_TREASURY_ADDRESS=0xREPLACE_ME
# Receives SpotExchange trading fees.
FEE_TREASURY_ADDRESS=0xREPLACE_ME
# Hot backend signer: KYC bridge, settlement, NAV publishing, funding, liquidation.
# This is the key the API server holds (APP_BLOCKCHAIN_OPERATOR_PRIVATE_KEY).
# It must hold AVAX for gas and must NOT be a cold/treasury address.
BACKEND_OPERATOR_ADDRESS=0xREPLACE_ME

# --- external stablecoins (verified on-chain 2026-09-16, all 6 decimals) ---
# Circle-native USDC on Avalanche C-Chain — symbol "USDC".
USDC_ADDRESS=0xB97EF9Ef8734C71904D8002F8b6Bc66Dd9c48a6E
# Tether-native USDt on Avalanche C-Chain — symbol "USDt".
USDT_ADDRESS=0x9702230A8Ea53601f5cD2dc00fDBc13d4dF4A8c7
# Bridged alternatives, for reference only (do NOT use unless deliberately chosen):
#   USDC.e 0xA7D7079b0FEaD91F3e65f86E8915Cb59c1a4C664
#   USDT.e 0xc7198437980c041c805A1EDcbA50c1Ce5db95118
# USDC is also SpotExchange's immutable quote token — this choice cannot be changed
# after deploy without redeploying SpotExchange.
DEPLOY_MOCK_STABLES=false

# --- token parameters ------------------------------------------------------
# RBT ERC-1155 metadata base. The placeholder is rejected by deploy.js.
FALLBACK_RBT_URI=https://metadata.weblock.land/rbt/{id}.json
# USDR initial supply in 6dp base units. 1_000_000_000_000 == 1,000,000 USDR.
# USDR is the perp collateral asset; mint only what the launch actually needs.
# 0 while perps stay closed — the Safe (MINTER) can mint later; minted supply cannot be un-minted.
USDR_INITIAL_SUPPLY=0
# WFT hard cap, 18dp. 1e27 == 1,000,000,000 WFT.
WFT_CAP=1000000000000000000000000000

# --- market parameters -----------------------------------------------------
NAV_MAX_DEVIATION_BPS=2000
NAV_MAX_STALENESS_SECS=86400
SPOT_FEE_BPS=100

# --- Gnosis Safe (governance) ---------------------------------------------
# Owner addresses, comma-separated. Use hardware wallets held by different people.
# 2-of-3 or 3-of-5 recommended; a 2-of-2 additionally needs SAFE_ALLOW_2OF2=yes
# because losing either key bricks governance permanently.
SAFE_OWNERS=0xOWNER_A,0xOWNER_B,0xOWNER_C
SAFE_THRESHOLD=2
SAFE_SALT=0
# SAFE_ALLOW_2OF2=yes

# Set once the Safe exists — consumed by safe-transfer-admin.js / verify-deployment.js.
SAFE_ADDRESS=

# --- launch seeding (scripts/seed-mainnet.js) -----------------------------
SEED_CONFIRM=
SEED_TOKEN_ID=1
# Price per RBT in pay-token base units (6dp). 10000000 == 10.00 USDC.
SEED_PRICE=10000000
SEED_MAX_SUPPLY=10000
# Unix seconds.
SEED_SALE_START=
SEED_SALE_END=
SEED_MATURITY=
# Address that receives sale proceeds for this series.
SEED_ISSUER_TREASURY=0xREPLACE_ME
SEED_SECONDARY_ENABLED=true
# Leave false and open the sale deliberately from the admin console.
SEED_OPEN_SALE=false
# Addresses to mark KYC-verified on-chain at seed time (operator, treasury).
# Real users are bridged automatically by the backend from Sumsub.
SEED_KYC_ADDRESSES=

# Perp market — only if perps launch at the same time as spot.
# perp stays closed until the audit (launch runbook §0-2). Setting this true
# additionally requires the five PERP_* values below.
SEED_PERP=false
# Read unconditionally by seed-mainnet.js, so it is required even when SEED_PERP
# is false. NAV per RBT, 6dp — usually the same as SEED_PRICE at launch.
SEED_NAV=10000000
PERP_INITIAL_MARGIN_BPS=2000
PERP_MAINTENANCE_MARGIN_BPS=1000
PERP_TAKER_FEE_BPS=10
PERP_MAKER_FEE_BPS=5
PERP_LIQUIDATION_FEE_BPS=200
